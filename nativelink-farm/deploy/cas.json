// cas 机: CAS + AC, filesystem 存储。schema 已用 nativelink v1.6.6 实测通过。
// max_bytes 按实际盘大小调。JSON5 注释若不被接受则删除本行(v1.6.6 支持)。
{
  "stores": [
    {
      "name": "CAS_MAIN",
      "verify": {
        "backend": {
          "filesystem": {
            "content_path": "/data/nativelink/cas/content",
            "temp_path": "/data/nativelink/cas/tmp",
            "eviction_policy": {
              "max_bytes": 500000000000
            }
          }
        },
        "verify_size": true,
        "verify_hash": true
      }
    },
    {
      "name": "AC_MAIN",
      "filesystem": {
        "content_path": "/data/nativelink/ac/content",
        "temp_path": "/data/nativelink/ac/tmp",
        "eviction_policy": {
          "max_bytes": 2000000000
        }
      }
    }
  ],
  "servers": [
    {
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50052"
        }
      },
      "services": {
        "cas": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN"
          }
        ],
        "ac": [
          {
            "instance_name": "main",
            "ac_store": "AC_MAIN"
          }
        ],
        "bytestream": [
          {
            "instance_name": "main",
            "cas_store": "CAS_MAIN"
          }
        ],
        "capabilities": [
          {
            "instance_name": "main"
          }
        ],
        "health": {}
      }
    }
  ]
}
