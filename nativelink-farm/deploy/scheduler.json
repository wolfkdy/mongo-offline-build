// 中转机: scheduler + worker_api。schema 已用 nativelink v1.6.6 实测通过。__CAS__ 换成 cas 机地址。
// 注意: v1.6.6 已移除 experimental_prometheus 拉取端点, 指标只能 OTLP 推送
// (队列深度指标为 nativelink_execution_active_count{execution_stage="queued"}), 见 DEPLOY-TODO 指标项。
{
  "stores": [
    {
      "name": "CAS_PROXY",
      "grpc": {
        "instance_name": "main",
        "endpoints": [
          {
            "address": "grpc://__CAS__:50052"
          }
        ],
        "store_type": "cas"
      }
    },
    {
      "name": "AC_PROXY",
      "grpc": {
        "instance_name": "main",
        "endpoints": [
          {
            "address": "grpc://__CAS__:50052"
          }
        ],
        "store_type": "ac"
      }
    }
  ],
  "schedulers": [
    {
      "name": "MAIN_SCHEDULER",
      "simple": {
        "supported_platform_properties": {
          "OSFamily": "exact",
          "container-image": "exact",
          "pool": "exact",
          "node": "exact",
          "cpu_count": "minimum",
          "memory_kb": "minimum"
        }
      }
    }
  ],
  "servers": [
    {
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50051"
        }
      },
      "services": {
        "execution": [
          {
            "instance_name": "main",
            "cas_store": "CAS_PROXY",
            "scheduler": "MAIN_SCHEDULER"
          }
        ],
        "capabilities": [
          {
            "instance_name": "main",
            "remote_execution": {
              "scheduler": "MAIN_SCHEDULER"
            }
          }
        ]
      }
    },
    {
      "listener": {
        "http": {
          "socket_address": "0.0.0.0:50061"
        }
      },
      "services": {
        "worker_api": {
          "scheduler": "MAIN_SCHEDULER"
        },
        "health": {},
        "admin": {
          "path": "/admin"
        }
      }
    }
  ]
}
