{
  "_comment": "中转机: scheduler + worker_api + metrics。CAS 不落本地，走 grpc 代理到 cas 机(__CAS__)。模板：上线前用目标版本 nativelink 验证 schema。",
  "stores": {
    "CAS_PROXY": {
      "grpc": {
        "instance_name": "main",
        "endpoints": [{ "address": "grpc://__CAS__:50052" }],
        "store_type": "cas"
      }
    },
    "AC_PROXY": {
      "grpc": {
        "instance_name": "main",
        "endpoints": [{ "address": "grpc://__CAS__:50052" }],
        "store_type": "ac"
      }
    }
  },
  "schedulers": {
    "MAIN_SCHEDULER": {
      "simple": {
        "supported_platform_properties": {
          "OSFamily": "exact",
          "container-image": "exact",
          "pool": "exact",
          "node": "exact",
          "cpu_count": "minimum",
          "memory_kb": "minimum"
        }
      }
    }
  },
  "servers": [
    {
      "_comment": "面向开发机 Bazel 的入口 (--remote_executor)",
      "listener": { "http": { "socket_address": "0.0.0.0:50051" } },
      "services": {
        "execution": {
          "main": { "cas_store": "CAS_PROXY", "scheduler": "MAIN_SCHEDULER" }
        },
        "capabilities": {
          "main": { "remote_execution": { "scheduler": "MAIN_SCHEDULER" } }
        }
      }
    },
    {
      "_comment": "面向 worker 注册 + 控制器抓指标",
      "listener": { "http": { "socket_address": "0.0.0.0:50061" } },
      "services": {
        "worker_api": { "scheduler": "MAIN_SCHEDULER" },
        "experimental_prometheus": { "path": "/metrics" },
        "health": {}
      }
    }
  ]
}
