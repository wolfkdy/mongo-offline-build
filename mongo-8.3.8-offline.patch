-    return proc.stdout.strip()[1:]
+    env_version = os.environ.get("MONGO_VERSION", "")
+    if env_version:
+        return env_version.lstrip("r")
+    try:
+        proc = subprocess.run(["git", "describe", "--abbrev=0"], capture_output=True, text=True)
+        version = proc.stdout.strip()[1:]
+        if version:
+            return version
+    except OSError:
+        pass
+    repo_root = pathlib.Path(os.path.abspath(__file__)).parent.parent.parent
+    version_file = os.path.join(repo_root, ".mongo_version")
+    if os.path.exists(version_file):
+        with open(version_file, encoding="utf-8") as f:
+            version = f.read().strip().lstrip("r")
+            if version:
+                return version
+    print(
+        "ERROR: could not determine the MongoDB version: the MONGO_VERSION "
+        "environment variable is unset, 'git describe' is unavailable (no git "
+        "binary or not a git checkout), and no .mongo_version file exists at "
+        f"the repo root ({repo_root}). Set MONGO_VERSION (e.g. "
+        "MONGO_VERSION=8.3.8) or create a .mongo_version file containing the "
+        "version.",
+        file=sys.stderr,
+    )
+    raise RuntimeError("unable to determine MONGO_VERSION")
 
 
